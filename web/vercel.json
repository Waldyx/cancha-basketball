{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .",
  "redirects": [
    {
      "source": "/((?!api/)(?!_astro/)[^.]*[^./])",
      "destination": "/$1/",
      "permanent": true
    }
  ]
}

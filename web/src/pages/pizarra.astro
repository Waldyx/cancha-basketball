---
// /pizarra — pizarra táctica de baloncesto, gratis y sin cuentas.
// Toda la lógica vive en src/lib/pizarra*.ts; esta página es el marco (HTML + CSS),
// el texto SEO y el arranque. Las jugadas se guardan en localStorage del navegador
// y se comparten por enlace (hash, nunca llega al servidor), imagen, vídeo o archivo.
import Base from "../layouts/Base.astro";
import ProGate from "../components/ProGate.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Pizarra táctica de baloncesto CANCHA.ZAPA",
  url: "https://canchazapa.com/pizarra",
  applicationCategory: "SportsApplication",
  operatingSystem: "Any",
  inLanguage: "es",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  description:
    "Pizarra táctica de baloncesto online y gratuita: dibuja jugadas en varios pasos, anímalas y compártelas por enlace, imagen, vídeo o PDF.",
};
---

<Base
  title="Pizarra de baloncesto online gratis | CANCHA.ZAPA"
  description="Pizarra táctica de baloncesto gratis: dibuja jugadas en varios pasos, anímalas y compártelas por enlace, imagen, vídeo o PDF. Sin registro, en tu móvil o tableta."
  jsonLd={jsonLd}
>
  <main class="app pz">
    <div class="pz-head">
      <h1 class="pz-h1">Pizarra táctica <span class="accent">de baloncesto</span></h1>
      <p class="pz-lede">Dibuja jugadas en varios pasos, anímalas y compártelas. Gratis, sin registro y en tu navegador.</p>
    </div>

    <div class="pz-app" data-pz="app">
      <div class="pz-banner" data-pz="banner" hidden>
        <span data-pz="banner-texto">Jugada compartida</span>
        <button type="button" class="pz-bn" data-act="guardar-compartida">Guardar en mi biblioteca</button>
        <button type="button" class="pz-bn pz-bn-2" data-act="editar-copia">Editar una copia</button>
      </div>

      <div class="pz-plhead" data-pz="pl-head">
        <strong class="pz-pl-nombre" data-pz="pl-nombre"></strong>
        <div class="pz-pl-lect" data-pz="pl-lect" role="group" aria-label="Elegir lectura" hidden></div>
        <div class="pz-pl-ctl" role="group" aria-label="Reproducción">
          <button type="button" class="pz-plb" data-act="pl-prev" aria-label="Paso anterior">◀</button>
          <button type="button" class="pz-plb pz-plb-play" data-act="pl-play" data-pz="pl-play" aria-label="Pausar">❚❚</button>
          <button type="button" class="pz-plb" data-act="pl-next" aria-label="Paso siguiente">▶</button>
          <select class="pz-vel" data-pz="pl-vel" aria-label="Velocidad">
            <option value="0.5">0,5×</option>
            <option value="1" selected>1×</option>
            <option value="1.5">1,5×</option>
          </select>
          <span class="pz-info pz-pl-paso" data-pz="pl-paso"></span>
        </div>
      </div>

      <div class="pz-toolbar" role="toolbar" aria-label="Herramientas de la pizarra">
        <div class="pz-grp pz-edit" role="group" aria-label="Seleccionar">
          <button type="button" class="pz-btn" data-tool="select" aria-label="Seleccionar y mover (V)" title="Seleccionar y mover (V)" aria-pressed="true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3l12 9-5.5 1.2L15 19l-2.6 1-2.4-5.6L6 17z" fill="currentColor" stroke-width="1"/></svg><span class="pz-lbl">Mover</span>
          </button>
        </div>
        <div class="pz-grp pz-edit" role="group" aria-label="Jugadores y material">
          <button type="button" class="pz-btn" data-tool="atq" aria-label="Atacante (A)" title="Atacante (A)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="currentColor" stroke="none"/><text x="12" y="16.2" text-anchor="middle" font-size="12" font-weight="900" fill="var(--cz-bg)" stroke="none" font-family="Inter,sans-serif">1</text></svg><span class="pz-lbl">Ataque</span>
          </button>
          <button type="button" class="pz-btn" data-tool="def" aria-label="Defensor (D)" title="Defensor (D)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke-width="2.2"/><text x="12" y="16.2" text-anchor="middle" font-size="12" font-weight="900" fill="currentColor" stroke="none" font-family="Inter,sans-serif">X</text></svg><span class="pz-lbl">Defensa</span>
          </button>
          <button type="button" class="pz-btn" data-tool="balon" aria-label="Balón (B)" title="Balón (B)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5v17M6 6c3 3 3 9 0 12M18 6c-3 3-3 9 0 12" stroke-width="1.3"/></svg><span class="pz-lbl">Balón</span>
          </button>
          <button type="button" class="pz-btn" data-tool="cono" aria-label="Cono (K)" title="Cono (K)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4l7.5 15h-15z" fill="currentColor" fill-opacity=".25"/><path d="M3.5 20h17"/></svg><span class="pz-lbl">Cono</span>
          </button>
          <button type="button" class="pz-btn" data-tool="neu" aria-label="Jugador neutro de ejercicio (G)" title="Jugador neutro, verde y sin número · para ejercicios (G)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="currentColor" fill-opacity=".45"/></svg><span class="pz-lbl">Neutro</span>
          </button>
          <button type="button" class="pz-btn" data-tool="ent" aria-label="Entrenador (E)" title="Entrenador (E)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" fill="currentColor" fill-opacity=".25"/><text x="12" y="17" text-anchor="middle" font-size="12" font-weight="900" fill="currentColor" stroke="none" font-family="Inter,sans-serif">E</text></svg><span class="pz-lbl">Entren.</span>
          </button>
          <button type="button" class="pz-btn" data-tool="fila" aria-label="Fila de jugadores esperando turno (I)" title="Fila de jugadores con el número de cuántos hay (I)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="3.2"/><circle cx="12.500" cy="12" r="3.200"/><circle cx="19" cy="12" r="3.200" fill="currentColor"/></svg><span class="pz-lbl">Fila</span>
          </button>
        </div>
        <div class="pz-grp pz-edit" role="group" aria-label="Líneas de movimiento">
          <button type="button" class="pz-btn" data-tool="pase" aria-label="Pase, flecha discontinua (P)" title="Pase · flecha discontinua (P)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19L17 7" stroke-dasharray="3.2 3"/><path d="M20 4.5l-6 1 5 5.2z" fill="currentColor"/></svg><span class="pz-lbl">Pase</span>
          </button>
          <button type="button" class="pz-btn" data-tool="bote" aria-label="Bote, zigzag (R)" title="Bote · zigzag (R)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 19l3-3.5-1.5-3 4 .5 -1-3 3.5 1.5 1.5-3 2 3 1.5-2.5"/><path d="M20.5 4l-5.5.8 3.6 4.4z" fill="currentColor"/></svg><span class="pz-lbl">Bote</span>
          </button>
          <button type="button" class="pz-btn" data-tool="corte" aria-label="Desplazamiento o corte, flecha continua (C)" title="Desplazamiento / corte · flecha continua (C)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19L16.5 7.5"/><path d="M20 4l-6 1 5 5.2z" fill="currentColor"/></svg><span class="pz-lbl">Corte</span>
          </button>
          <button type="button" class="pz-btn" data-tool="bloqueo" aria-label="Bloqueo, línea terminada en T (L)" title="Bloqueo · línea terminada en T (L)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19L15.5 9"/><path d="M12.5 5.5l6.5 7" stroke-width="2.4"/></svg><span class="pz-lbl">Bloqueo</span>
          </button>
          <button type="button" class="pz-btn" data-tool="tiro" aria-label="Tiro (S)" title="Tiro · línea punteada (S)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19L17 7" stroke-dasharray=".1 3.6" stroke-width="3"/><path d="M20 4.5l-6 1 5 5.2z" fill="currentColor"/></svg><span class="pz-lbl">Tiro</span>
          </button>
          <button type="button" class="pz-btn" data-tool="rotacion" aria-label="Rotación: adónde va después, línea fina punteada (O)" title="Rotación · adónde va el jugador después (O)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19L17 7" stroke-dasharray=".1 2.6" stroke-width="2"/><path d="M20 4.500l-4.500.8 3.700 3.800z" fill="currentColor"/></svg><span class="pz-lbl">Rotación</span>
          </button>
          <button type="button" class="pz-btn" data-tool="zona" aria-label="Zona sombreada rectangular (Z)" title="Zona sombreada: rectángulo (Z)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="12" stroke-dasharray="3 2.200" fill="currentColor" fill-opacity=".2"/></svg><span class="pz-lbl">Zona</span>
          </button>
          <button type="button" class="pz-btn" data-tool="elipse" aria-label="Zona sombreada elíptica (X)" title="Zona sombreada: elipse (X)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="12" rx="8.500" ry="6" stroke-dasharray="3 2.200" fill="currentColor" fill-opacity=".2"/></svg><span class="pz-lbl">Elipse</span>
          </button>
          <button type="button" class="pz-btn" data-tool="libre" aria-label="Trazo libre (F)" title="Trazo libre (F)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 15c2-8 4.500 5 7-2s4-7 6-3 3 4 5 1"/></svg><span class="pz-lbl">Libre</span>
          </button>
          <button type="button" class="pz-btn" data-tool="texto" aria-label="Texto o nota (N)" title="Texto o nota (N)" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><text x="12" y="17" text-anchor="middle" font-size="14" font-weight="900" fill="currentColor" stroke="none" font-family="Inter,sans-serif">Aa</text></svg><span class="pz-lbl">Texto</span>
          </button>
        </div>
        <div class="pz-grp pz-edit" role="group" aria-label="Formaciones">
          <button type="button" class="pz-btn" data-act="formaciones" aria-label="Formaciones rápidas de ataque y defensa" title="Formaciones rápidas: 1-3-1, zona 2-3, individual…">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="12" r="2.2"/><circle cx="19" cy="12" r="2.2"/><circle cx="8" cy="19" r="2.2"/><circle cx="16" cy="19" r="2.2"/></svg><span class="pz-lbl">Formaciones</span>
          </button>
        </div>
        <div class="pz-grp pz-edit" role="group" aria-label="Historial">
          <button type="button" class="pz-btn" data-act="deshacer" aria-label="Deshacer (Ctrl+Z)" title="Deshacer (Ctrl+Z)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 010 12h-3"/></svg><span class="pz-lbl">Deshacer</span>
          </button>
          <button type="button" class="pz-btn" data-act="rehacer" aria-label="Rehacer (Ctrl+Y)" title="Rehacer (Ctrl+Y)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 14l5-5-5-5"/><path d="M20 9H10a6 6 0 000 12h3"/></svg><span class="pz-lbl">Rehacer</span>
          </button>
          <button type="button" class="pz-btn" data-act="limpiar" aria-label="Limpiar el paso" title="Limpiar el paso">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg><span class="pz-lbl">Limpiar</span>
          </button>
        </div>
        <div class="pz-grp" role="group" aria-label="Vista">
          <select class="pz-vel pz-edit pz-pista" data-pz="pista" aria-label="Tipo de pista y tamaño" title="Pista FIBA o de minibasket, media o completa">
            <option value="fiba-media">FIBA · media pista</option>
            <option value="fiba-completa">FIBA · pista completa</option>
            <option value="mini-media">Minibasket (aro 2,60 m) · media</option>
            <option value="mini-completa">Minibasket (aro 2,60 m) · completa</option>
          </select>
          <button type="button" class="pz-btn pz-edit" data-act="orient" aria-label="Girar la pista (horizontal o vertical)" title="Girar la pista">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 11-3-6.200"/><path d="M20 4v5h-5"/></svg><span class="pz-lbl">Girar</span>
          </button>
          <button type="button" class="pz-btn" data-act="fondo" aria-label="Cambiar el color de la pista" title="Color de la pista">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.500"/><path d="M12 3.500a8.500 8.500 0 000 17z" fill="currentColor"/></svg><span class="pz-lbl">Parqué</span>
          </button>
          <button type="button" class="pz-btn" data-act="pantalla" aria-label="Pantalla completa" title="Pantalla completa">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg><span class="pz-lbl">Pantalla</span>
          </button>
        </div>
        <div class="pz-grp pz-grp-fin" role="group" aria-label="Compartir y guardar">
          <button type="button" class="pz-btn" data-act="ses" data-pro="pizarra-sesiones" aria-label="Sesión de entrenamiento: plan con ejercicios y minutos" title="Sesión de entrenamiento: plan con ejercicios y minutos">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12v17H6zM9 4V2.500h6V4M9 10h6M9 14h6M9 18h3"/></svg><span class="pz-lbl">Sesión</span>
          </button>
          <button type="button" class="pz-btn pz-btn-tm" data-act="tm" aria-label="Tiempo muerto: pizarra a pantalla completa (T)" title="Tiempo muerto: pantalla limpia para el banquillo (T)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13.5" r="7.5"/><path d="M12 9.500v4.500l3 2M9.500 3h5"/></svg><span class="pz-lbl">Tiempo muerto</span>
          </button>
          <button type="button" class="pz-btn pz-edit" data-act="guardar" aria-label="Guardar en mi biblioteca (Ctrl+S)" title="Guardar en mi biblioteca (Ctrl+S)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h11l3 3v13H5z"/><path d="M8 4v5h7V4M8 20v-6h8v6"/></svg><span class="pz-lbl">Guardar</span>
          </button>
          <button type="button" class="pz-btn pz-btn-acc" data-act="compartir" aria-label="Compartir o exportar" title="Compartir o exportar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.500"/><circle cx="18" cy="6" r="2.500"/><circle cx="18" cy="18" r="2.500"/><path d="M8.200 10.800l7.600-3.600M8.200 13.200l7.600 3.600"/></svg><span class="pz-lbl">Compartir</span>
          </button>
        </div>
      </div>

      <div class="pz-main">
        <div class="pz-board">
          <div class="pz-court" data-pz="court">
            <svg class="pz-svg" data-pz="svg" viewBox="-2 -2 19 18" role="img" aria-label="Pizarra táctica: pista de baloncesto con los jugadores y las líneas de la jugada"></svg>
          </div>
          <div class="pz-tmbar" data-pz="tmbar" role="toolbar" aria-label="Tiempo muerto">
            <button type="button" class="pz-tmb" data-act="formaciones">Formaciones</button>
            <button type="button" class="pz-tmb" data-act="deshacer" aria-label="Deshacer">Deshacer</button>
            <button type="button" class="pz-tmb" data-act="tm-goma" aria-label="Borrar todas las líneas">Goma</button>
            <button type="button" class="pz-tmb pz-tmb-reset" data-act="tm-reset">Reset</button>
            <button type="button" class="pz-tmb pz-tmb-x" data-act="tm-salir" aria-label="Salir del tiempo muerto">Salir ✕</button>
            <p class="pz-tmhint">Arrastra una pieza para moverla · Mantén pulsada una pieza (o tócala) y arrastra para dibujar su flecha · Toca una línea para borrarla</p>
          </div>
          <div class="pz-selbar" data-pz="selbar" hidden></div>
          <div class="pz-hint" data-pz="hint"></div>

          <div class="pz-share pz-formaciones" data-pz="formaciones" role="dialog" aria-label="Formaciones rápidas" hidden>
            <div class="pz-share-h">
              <strong>Formaciones rápidas</strong>
              <button type="button" class="pz-x" data-act="cerrar-formaciones" aria-label="Cerrar">✕</button>
            </div>
            <p class="pz-small">Colocan a los jugadores en el paso actual (los que ya tengas se mueven, los que falten se crean). Se pueden deshacer.</p>
            <label class="pz-chk" data-pz="form-espejo" hidden><input type="checkbox" data-act="form-espejo" /> Atacar la canasta de la derecha</label>
            <div data-pz="formaciones-lista"></div>
          </div>

          <div class="pz-share pz-banq" data-pz="banquillo" role="dialog" aria-label="Hoja de banquillo" hidden>
            <div class="pz-share-h">
              <strong>Hoja de banquillo</strong>
              <button type="button" class="pz-x" data-act="cerrar-banquillo" aria-label="Cerrar">✕</button>
            </div>
            <p class="pz-small">Varias jugadas por folio, compactas y con el nombre grande, para llevarlas al partido.</p>
            <fieldset class="pz-banq-fs">
              <legend>Jugadas por página</legend>
              <label><input type="radio" name="banq-n" value="4" /> 4</label>
              <label><input type="radio" name="banq-n" value="6" checked /> 6</label>
            </fieldset>
            <fieldset class="pz-banq-fs">
              <legend>Dibujo de cada jugada</legend>
              <label><input type="radio" name="banq-modo" value="todos" checked /> Todos los pasos superpuestos</label>
              <label><input type="radio" name="banq-modo" value="ultimo" /> Solo el último paso</label>
            </fieldset>
            <div class="pz-row">
              <button type="button" class="pz-bn pz-bn-2 pz-bn-sm" data-act="banq-todas">Marcar todas</button>
              <button type="button" class="pz-bn pz-bn-2 pz-bn-sm" data-act="banq-ninguna">Ninguna</button>
            </div>
            <ul class="pz-banq-lista" data-pz="banq-lista"></ul>
            <div class="pz-row">
              <button type="button" class="pz-bn" data-act="banq-imprimir">Imprimir o PDF</button>
            </div>
          </div>

          <div class="pz-share pz-qr" data-pz="qr" role="dialog" aria-label="Código QR del enlace para jugadores" hidden>
            <div class="pz-share-h">
              <strong>Código QR · modo jugador</strong>
              <button type="button" class="pz-x" data-act="cerrar-qr" aria-label="Cerrar">✕</button>
            </div>
            <div class="pz-qr-box" data-pz="qr-img"></div>
            <p class="pz-small" data-pz="qr-aviso"></p>
            <div class="pz-row">
              <button type="button" class="pz-bn" data-act="qr-grande">Mostrar más grande</button>
              <button type="button" class="pz-bn pz-bn-2" data-act="copy-link-jugador" data-pro="pizarra-jugador">Copiar enlace</button>
            </div>
          </div>

          <div class="pz-share" data-pz="share" role="dialog" aria-label="Compartir y exportar" hidden>
            <div class="pz-share-h">
              <strong>Compartir</strong>
              <button type="button" class="pz-x" data-act="cerrar-share" aria-label="Cerrar">✕</button>
            </div>
            <div class="pz-share-s">
              <h3>Enlace</h3>
              <input type="text" class="pz-inp" data-pz="enlace" readonly aria-label="Enlace de la jugada" />
              <p class="pz-small" data-pz="enlace-info"></p>
              <div class="pz-row">
                <button type="button" class="pz-bn" data-act="copy-link">Copiar enlace</button>
                <button type="button" class="pz-bn pz-bn-2" data-act="share-native">Compartir…</button>
                <button type="button" class="pz-bn pz-bn-2" data-act="copy-book">Enlace del playbook</button>
              </div>
            </div>
            <div class="pz-share-s">
              <h3>Para tus jugadores (solo ver)</h3>
              <div class="pz-row">
                <button type="button" class="pz-bn" data-act="copy-link-jugador" data-pro="pizarra-jugador">Copiar enlace de solo ver</button>
                <button type="button" class="pz-bn pz-bn-2" data-act="qr" data-pro="pizarra-jugador">Código QR</button>
              </div>
              <p class="pz-small">Abre la jugada a pantalla casi completa, repitiéndose en bucle y con las notas, sin las herramientas de edición. Con el QR la escanean desde la tableta o el proyector.</p>
            </div>
            <div class="pz-share-s">
              <h3>Imagen (WhatsApp, correo)</h3>
              <div class="pz-row">
                <button type="button" class="pz-bn pz-bn-2" data-act="png-paso">PNG del paso actual</button>
                <button type="button" class="pz-bn pz-bn-2" data-act="png-hoja">Hoja con todos los pasos</button>
              </div>
            </div>
            <div class="pz-share-s">
              <h3>Animación (GIF y vídeo)</h3>
              <div class="pz-row">
                <button type="button" class="pz-bn" data-act="gif" data-pro="pizarra-animacion">Exportar GIF</button>
                <button type="button" class="pz-bn pz-bn-2" data-act="compartir-gif" data-pz="compartir-gif" hidden>Compartir el GIF</button>
              </div>

---
// /asistencia — pasar lista en los entrenamientos y preparar la convocatoria para el grupo de las
// familias. Lógica pura en lib/asistencia.ts. Todo en el navegador (cz.asistencia.v1); el mensaje de
// la convocatoria solo sale si el entrenador lo copia o lo comparte.
import "../styles/cancha-redesign.css";
import Base from "../layouts/Base.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Asistencia y convocatorias de baloncesto CANCHA.ZAPA",
  url: "https://canchazapa.com/asistencia/",
  applicationCategory: "SportsApplication",
  operatingSystem: "Any",
  inLanguage: "es",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  description: "Pasa lista en cada entrenamiento, consulta el porcentaje de asistencia de cada jugador y prepara la convocatoria del partido para el grupo de WhatsApp.",
};
---

<Base
  title="Asistencia a entrenamientos y convocatorias de baloncesto | CANCHA.ZAPA"
  description="Pasa lista en cada entrenamiento con un toque, mira el % de asistencia de cada jugador y prepara la convocatoria del partido lista para WhatsApp. Gratis y sin registro."
  jsonLd={jsonLd}
>
  <main class="app">
    <section class="doc-hero">
      <div class="shell">
        <p class="cz-eyebrow">★ Entrenadores · Equipo</p>
        <h1 class="doc-h1">Asistencia y <span class="accent">convocatorias</span></h1>
        <p class="doc-lede">
          Pasa lista en cada entrenamiento con un toque y prepara la convocatoria del partido para el grupo de las familias.
          Todo se guarda en tu navegador.
        </p>
      </div>
    </section>

    <div class="shell as">
      <details class="as-panel as-det" id="as-plantilla-det">
        <summary>Jugadores</summary>
        <label class="as-campo" id="as-equipo-campo" hidden>
          <span>Cargar plantilla</span>
          <select id="as-equipo" class="as-inp"></select>
        </label>
        <label class="as-campo">
          <span>Uno por línea</span>
          <textarea id="as-jugadores" class="as-inp as-ta" rows="5" placeholder={"4 Laia\n7 Marc\n…"}></textarea>
        </label>
      </details>

      <div class="as-cols">
        <section class="as-panel">
          <h2 class="as-h2">Pasar lista</h2>
          <div class="as-fila">
            <label class="as-campo"><span>Entrenamiento</span><select id="as-sesion" class="as-inp"></select></label>
            <label class="as-campo"><span>Nuevo</span><input id="as-fecha" type="date" class="as-inp" /></label>
            <button type="button" id="as-nueva" class="as-bn">Crear</button>
          </div>
          <p class="as-ayuda">Toca a cada jugador: <b class="as-k si">✓</b> ha venido · <b class="as-k no">✗</b> falta · <b class="as-k just">J</b> justificada.</p>
          <div id="as-lista" class="as-lista"></div>
          <div class="as-fila">
            <button type="button" id="as-todos" class="as-bn as-bn-2 as-bn-sm">Todos presentes</button>
            <button type="button" id="as-borrar" class="as-bn as-bn-2 as-bn-sm">Borrar entrenamiento</button>
          </div>
          <h2 class="as-h2">Asistencia de la temporada</h2>
          <table class="as-tabla" id="as-resumen"></table>
        </section>

        <section class="as-panel">
          <h2 class="as-h2">Convocatoria</h2>
          <div class="as-grid2">
            <label class="as-campo"><span>Equipo</span><input id="cv-equipo" class="as-inp" maxlength="40" /></label>
            <label class="as-campo"><span>Rival</span><input id="cv-rival" class="as-inp" maxlength="40" /></label>
            <label class="as-campo"><span>Fecha</span><input id="cv-fecha" type="date" class="as-inp" /></label>
            <label class="as-campo"><span>Hora del partido</span><input id="cv-hora" type="time" class="as-inp" /></label>
            <label class="as-campo"><span>Hora de quedada</span><input id="cv-quedada" type="time" class="as-inp" /></label>
            <label class="as-campo"><span>Equipación</span><input id="cv-equipacion" class="as-inp" maxlength="40" placeholder="Blanca" /></label>
          </div>
          <label class="as-campo"><span>Lugar</span><input id="cv-lugar" class="as-inp" maxlength="80" /></label>
          <label class="as-campo"><span>Notas</span><textarea id="cv-notas" class="as-inp" rows="2" maxlength="300"></textarea></label>
          <p class="as-ayuda">Convocados:</p>
          <div id="cv-convocados" class="as-chips"></div>
          <label class="as-campo"><span>Mensaje</span><textarea id="cv-texto" class="as-inp as-ta" rows="10" readonly></textarea></label>
          <div class="as-fila">
            <button type="button" id="cv-copiar" class="as-bn">Copiar</button>
            <button type="button" id="cv-compartir" class="as-bn as-bn-2">Compartir…</button>
          </div>
          <p id="cv-estado" class="as-ayuda" role="status"></p>
        </section>
      </div>
      <p class="as-privado">Los nombres se guardan solo en este navegador. La convocatoria solo sale de aquí si tú la copias o la compartes.</p>
    </div>
  </main>
</Base>

<style is:global>
  .as { padding-top: 20px; padding-bottom: 60px; display: flex; flex-direction: column; gap: 14px; }
  .as-panel { display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; background: var(--cz-card); border: 1px solid var(--cz-border); min-width: 0; }
  .as-cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  @media (max-width: 860px) { .as-cols { grid-template-columns: 1fr; } }
  .as-h2 { margin: 6px 0 0; font: 900 20px "Barlow Condensed", sans-serif; text-transform: uppercase; color: var(--cz-text); }
  .as-det summary { cursor: pointer; font: 800 13px "Inter", sans-serif; color: var(--cz-accent-text); }
  .as-det[open] > :not(summary) { margin-top: 8px; }
  .as-fila { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; }
  .as-fila > .as-campo { flex: 1 1 140px; }
  .as-grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .as-campo { display: flex; flex-direction: column; gap: 3px; min-width: 0; font: 800 10px "Inter", sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--cz-text-2); }
  .as-inp { width: 100%; min-width: 0; min-height: 40px; padding: 6px 10px; background: var(--cz-bg); color: var(--cz-text); border: 1px solid var(--cz-border); border-radius: 0; font: 600 14px "Inter", sans-serif; text-transform: none; letter-spacing: 0; }
  .as-ta { min-height: 100px; resize: vertical; }
  .as-bn { min-height: 42px; padding: 0 16px; background: #f97316; border: 1px solid #f97316; color: #0c0c0c; font: 900 12px "Inter", sans-serif; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; border-radius: 0; }
  .as-bn-2 { background: transparent; color: var(--cz-text); border-color: var(--cz-border); }
  .as-bn-sm { min-height: 36px; padding: 0 12px; font-size: 11px; }
  .as-ayuda, .as-privado { margin: 0; font-size: 12px; color: var(--cz-text-2); }
  .as-k { display: inline-flex; width: 18px; height: 18px; align-items: center; justify-content: center; font-size: 11px; color: #fff; }
  .as-k.si, .as-j[data-e="si"] { background: #16a34a; border-color: #16a34a; color: #fff; }
  .as-k.no, .as-j[data-e="no"] { background: #dc2626; border-color: #dc2626; color: #fff; }
  .as-k.just, .as-j[data-e="just"] { background: #ca8a04; border-color: #ca8a04; color: #fff; }
  .as-lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 6px; }
  .as-j { min-height: 44px; padding: 4px 8px; text-align: left; background: var(--cz-bg); border: 1px solid var(--cz-border); color: var(--cz-text); font: 700 13px "Inter", sans-serif; cursor: pointer; border-radius: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .as-j::before { content: "–  "; font-weight: 900; }
  .as-j[data-e="si"]::before { content: "✓  "; }
  .as-j[data-e="no"]::before { content: "✗  "; }
  .as-j[data-e="just"]::before { content: "J  "; }
  .as-tabla { width: 100%; border-collapse: collapse; font: 600 13px "Inter", sans-serif; }
  .as-tabla th, .as-tabla td { padding: 5px 8px; border-bottom: 1px solid var(--cz-border); text-align: right; }
  .as-tabla th { font: 800 10px "Inter", sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--cz-text-2); }
  .as-tabla th:first-child, .as-tabla td:first-child { text-align: left; }
  .as-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .as-chip { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border: 1px solid var(--cz-border); font-size: 13px; color: var(--cz-text); cursor: pointer; }
  .as-chip input { width: 16px; height: 16px; }
</style>

<script>
  import { CLAVE_EQUIPO, equiposDeTexto } from "../lib/pizarraEquipo";
  import { SIGUIENTE, normalizarStoreAsistencia, plantilla, resumen, textoConvocatoria, LIMITES_ASISTENCIA, type StoreAsistencia } from "../lib/asistencia";

  const CLAVE = "cz.asistencia.v1";
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let st: StoreAsistencia = normalizarStoreAsistencia(null);
  try {
    st = normalizarStoreAsistencia(JSON.parse(localStorage.getItem(CLAVE) ?? "null"));
  } catch {
    /* empezar de cero */
  }
  const guardar = () => {
    try {
      localStorage.setItem(CLAVE, JSON.stringify(st));
    } catch {
      /* sin almacenamiento */
    }
  };
  const hoy = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  };
  let activa = st.sesiones[0]?.id ?? "";
  const sesion = () => st.sesiones.find((s) => s.id === activa);
  const fechaCorta = (f: string) => f.split("-").reverse().join("/");

  function el(tag: string, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  // ── pasar lista ─────────────────────────────────────────────────────
  function pintarLista() {
    const js = plantilla(st.jugadores);
    const sel = $<HTMLSelectElement>("as-sesion");
    sel.replaceChildren(...st.sesiones.map((s) => new Option(fechaCorta(s.fecha), s.id)));
    sel.value = activa;
    const lista = $("as-lista");
    lista.replaceChildren();
    const s = sesion();
    if (!js.length) lista.append(el("p", "as-ayuda", "Escribe primero los jugadores (arriba, en «Jugadores»)."));
    else if (!s) lista.append(el("p", "as-ayuda", "Crea un entrenamiento con su fecha para pasar lista."));
    else
      for (const j of js) {
        const b = el("button", "as-j", j) as HTMLButtonElement;
        b.type = "button";
        b.dataset.e = s.lista[j] ?? "";
        b.addEventListener("click", () => {
          const n = SIGUIENTE[s.lista[j] ?? ""];
          if (n) s.lista[j] = n;
          else delete s.lista[j];
          guardar();
          pintarLista();
        });
        lista.append(b);
      }
    // resumen de la temporada
    const t = $<HTMLTableElement>("as-resumen");
    t.replaceChildren();
    if (!js.length || !st.sesiones.length) return;
    const cab = el("tr");
    for (const h of ["Jugador", "✓", "✗", "J", "%"]) cab.append(el("th", undefined, h));
    t.append(cab);
    for (const f of resumen(js, st.sesiones)) {
      const tr = el("tr");
      for (const v of [f.jugador, String(f.si), String(f.no), String(f.just), f.pct === null ? "—" : `${f.pct} %`]) tr.append(el("td", undefined, v));
      t.append(tr);
    }
  }

  $("as-nueva").addEventListener("click", () => {
    const fecha = $<HTMLInputElement>("as-fecha").value || hoy();
    const ya = st.sesiones.find((s) => s.fecha === fecha);
    if (ya) activa = ya.id;
    else {
      if (st.sesiones.length >= LIMITES_ASISTENCIA.SESIONES) st.sesiones.pop();
      const s = { id: Math.random().toString(36).slice(2, 10), fecha, lista: {} };
      st.sesiones.push(s);
      st.sesiones.sort((a, b) => b.fecha.localeCompare(a.fecha));
      activa = s.id;
      guardar();
    }
    pintarLista();
  });
  $<HTMLSelectElement>("as-sesion").addEventListener("change", (e) => {
    activa = (e.target as HTMLSelectElement).value;
    pintarLista();
  });
  $("as-todos").addEventListener("click", () => {
    const s = sesion();
    if (!s) return;
    for (const j of plantilla(st.jugadores)) s.lista[j] = "si";
    guardar();
    pintarLista();
  });
  $("as-borrar").addEventListener("click", () => {
    const s = sesion();
    if (!s || !confirm(`¿Borrar el entrenamiento del ${fechaCorta(s.fecha)}?`)) return;
    st.sesiones = st.sesiones.filter((x) => x.id !== s.id);
    activa = st.sesiones[0]?.id ?? "";
    guardar();
    pintarLista();
  });

  // ── convocatoria ────────────────────────────────────────────────────
  const fuera = new Set<string>();
  const v = (id: string) => ($(id) as HTMLInputElement).value.trim();
  function pintarConvocatoria() {
    const js = plantilla(st.jugadores);
    const cont = $("cv-convocados");
    cont.replaceChildren();
    for (const j of js) {
      const l = el("label", "as-chip");
      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.checked = !fuera.has(j);
      cb.addEventListener("change", () => {
        if (cb.checked) fuera.delete(j);
        else fuera.add(j);
        textoCv();
      });
      l.append(cb, j);
      cont.append(l);
    }
    textoCv();
  }
  function textoCv() {
    $<HTMLTextAreaElement>("cv-texto").value = textoConvocatoria({
      equipo: v("cv-equipo"),
      rival: v("cv-rival"),
      fecha: v("cv-fecha"),
      hora: v("cv-hora"),
      quedada: v("cv-quedada"),
      lugar: v("cv-lugar"),
      equipacion: v("cv-equipacion"),
      notas: ($("cv-notas") as HTMLTextAreaElement).value,
      convocados: plantilla(st.jugadores).filter((j) => !fuera.has(j)),
    });
  }
  for (const id of ["cv-equipo", "cv-rival", "cv-fecha", "cv-hora", "cv-quedada", "cv-lugar", "cv-equipacion", "cv-notas"]) $(id).addEventListener("input", textoCv);
  $("cv-copiar").addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText($<HTMLTextAreaElement>("cv-texto").value);
      $("cv-estado").textContent = "Copiado: pégalo en el grupo de WhatsApp.";
    } catch {
      $<HTMLTextAreaElement>("cv-texto").select();
      $("cv-estado").textContent = "Selecciona el texto y cópialo (Ctrl+C).";
    }
  });
  $("cv-compartir").addEventListener("click", async () => {
    const text = $<HTMLTextAreaElement>("cv-texto").value;
    if (typeof navigator.share === "function") {
      try {
        await navigator.share({ text });
      } catch {
        /* cancelado */
      }
    } else $("cv-estado").textContent = "Este navegador no puede compartir directamente: usa «Copiar».";
  });

  // ── plantilla ───────────────────────────────────────────────────────
  const txt = $<HTMLTextAreaElement>("as-jugadores");
  txt.value = st.jugadores;
  txt.addEventListener("input", () => {
    st.jugadores = txt.value.slice(0, 2000);
    guardar();
    pintarLista();
    pintarConvocatoria();
  });
  try {
    const eqs = equiposDeTexto(localStorage.getItem(CLAVE_EQUIPO));
    if (eqs.length) {
      const sel = $<HTMLSelectElement>("as-equipo");
      $("as-equipo-campo").hidden = false;
      sel.append(new Option("Elige un equipo…", ""), ...eqs.map((e) => new Option(e.categoria ? `${e.nombre} · ${e.categoria}` : e.nombre, e.id)));
      sel.addEventListener("change", () => {
        const eq = eqs.find((x) => x.id === sel.value);
        if (!eq) return;
        st.jugadores = eq.jugadores.map((j) => `${j.dorsal} ${j.nombre}`.trim()).join("\n");
        txt.value = st.jugadores;
        if (!v("cv-equipo")) ($("cv-equipo") as HTMLInputElement).value = eq.nombre;
        guardar();
        pintarLista();
        pintarConvocatoria();
        sel.value = "";
      });
    }
  } catch {
    /* sin equipo */
  }

  ($("as-fecha") as HTMLInputElement).value = hoy();
  if (!st.jugadores) ($("as-plantilla-det") as HTMLDetailsElement).open = true;
  pintarLista();
  pintarConvocatoria();
</script>

---
// /entrenadores — página de entrada para entrenadores: lo que hay, lo que será Pro y lo que viene.
import "../styles/cancha-redesign.css";
import Base from "../layouts/Base.astro";
import HubGrid from "../components/HubGrid.astro";

const herramientas = [
  { href: "/pizarra/", tag: "Pizarra", label: "Pizarra táctica", desc: "Dibuja jugadas en varios pasos, anímalas y compártelas por enlace. Pista FIBA o minibasket." },
  { href: "/pizarra/", tag: "Pizarra", label: "Plantillas y ejercicios", desc: "Jugadas de ataque y defensa, contraataques y ejercicios listos para cargar y adaptar." },
  { href: "/pizarra/", tag: "Club", label: "Playbook con tu escudo", desc: "Imprime o guarda en PDF tus jugadas, la hoja de banquillo y las sesiones con el escudo y el color de tu club.", pro: true },
  { href: "/pizarra/", tag: "Pizarra", label: "Sesiones de entrenamiento", desc: "Planifica la sesión con minutos por ejercicio, compártela e imprímela para la pista.", pro: true },
  { href: "/pizarra/", tag: "Pizarra", label: "Modo jugador, QR y GIF", desc: "Tus jugadores ven la jugada en su móvil con un QR, o la descargan como GIF animado.", pro: true },
  { href: "/estadisticas/", tag: "Estadísticas", label: "Estadísticas de equipo", desc: "Tabla de temporada, líderes, tarjetas y envío de sus números a cada jugador.", pro: true },
  { href: "/estadisticas/", tag: "Estadísticas", label: "Agente de estadísticas", desc: "Pregunta a la IA por tus partidos: tendencias, quién rinde y qué corregir.", pro: true },
  { href: "/minutos/", tag: "Partido", label: "Control de minutos", desc: "Quién sale de inicio en cada período, con aviso en directo si alguien no cumple la norma de participación (FCBQ o la tuya)." },
  { href: "/tiro/", tag: "Partido", label: "Mapa de tiro", desc: "Toca en la pista dónde se tira y si entra: porcentaje por jugador y por zona. La temporada entera, en Pro." },
  { href: "/rival/", tag: "Rival", label: "Informe del rival", desc: "Junta las actas de tu próximo rival (FEB o pegadas de tu federación): quién anota, quién tira de tres y quién se carga de faltas." },
  { href: "/familias/", tag: "Familias", label: "Informe para las familias", desc: "Una hoja por jugador con su temporada en positivo: números, evolución, puntos fuertes y tus palabras.", pro: true },
  { href: "/video/", tag: "Vídeo", label: "Etiquetas de vídeo", desc: "Abre el vídeo del partido sin subirlo a ningún sitio, marca momentos con un toque y salta de uno a otro. Verlos seguidos, en Pro." },
];

---

<Base
  title="Herramientas para entrenadores de baloncesto | CANCHA.ZAPA"
  description="Pizarra táctica, plantillas, ejercicios, sesiones de entrenamiento y estadísticas de equipo para entrenadores de baloncesto. Gratis y sin registro."
>
  <main class="app">
    <section class="doc-hero">
      <div class="shell">
        <p class="cz-eyebrow">★ Entrenadores</p>
        <h1 class="doc-h1">Para <span class="accent">entrenadores</span></h1>
        <p class="doc-lede">
          Prepara entrenamientos, explica jugadas y sigue a tu equipo desde el móvil o la tableta. Sin
          registro: los datos de tus jugadores no salen de tu dispositivo.
        </p>
      </div>
    </section>

    <article class="doc-article">
      <div class="shell">
        <section class="doc-section">
          <div class="doc-section-head">
            <span class="doc-num">01</span>
            <h2 class="doc-h2">Ya disponible</h2>
          </div>
          <p class="doc-body">
            Lo marcado como <strong>Pro</strong> será de pago más adelante. Durante la beta es gratis para todos.
          </p>
          <HubGrid items={herramientas} />
        </section>

        <p class="doc-body">
          ¿Lo quieres para todos los equipos de tu club? Mira la <a href="/clubs/" class="doc-link">licencia para clubs →</a>
        </p>
      </div>
    </article>
  </main>
</Base>

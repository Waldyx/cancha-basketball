---
// Header global (rediseño s37): sticky con blur, barra de progreso de scroll,
// menú hamburguesa en móvil (≤860px) y toggle de tema claro/oscuro.
// El enlace activo se deriva de la URL — las páginas ya no marcan su nav a mano.
const path = Astro.url.pathname;
const links = [
  { href: "/quiz", label: "Quiz" },
  { href: "/comparar", label: "Comparar" },
  { href: "/rankings", label: "Rankings" },
  { href: "/zapatillas", label: "Catálogo" },
  { href: "/calculadora", label: "Calculadora" },
  { href: "/estadisticas", label: "Stats" },
  { href: "/balones", label: "Accesorios" },
  { href: "/blog", label: "Blog" },
  { href: "/mis-zapas", label: "♥ Mis zapas" },
];
const isActive = (href: string) =>
  path === href ||
  path.startsWith(href + "/") ||
  (href === "/zapatillas" && path.startsWith("/zapatilla/")) ||
  (href === "/quiz" && path.startsWith("/resultados"));
---

<div class="czh-progress" aria-hidden="true"></div>
<div class="czh-strip" aria-hidden="true"></div>

<header class="czh">
  <div class="czh-inner">
    <a href="/" class="czh-logo">CANCHA<span class="czh-dot">.</span>ZAPA</a>

    <nav class="czh-nav" aria-label="Principal">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={["czh-link", { active: isActive(l.href) }]}
          aria-current={isActive(l.href) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
      <button class="czh-theme" type="button" title="Cambiar tema" aria-label="Cambiar tema">☀</button>
    </nav>

    <div class="czh-mobile-actions">
      <button class="czh-theme czh-theme-m" type="button" title="Cambiar tema" aria-label="Cambiar tema">☀</button>
      <button class="czh-burger" type="button" aria-label="Menú" aria-expanded="false">☰</button>
    </div>
  </div>

  <nav class="czh-panel" aria-label="Principal móvil" hidden>
    {links.map((l) => (
      <a
        href={l.href}
        class:list={["czh-panel-link", { active: isActive(l.href) }]}
        aria-current={isActive(l.href) ? "page" : undefined}
      >
        {l.label} <span class="czh-arrow">→</span>
      </a>
    ))}
    <div class="czh-panel-cta">
      <a href="/quiz">→ Empezar el quiz</a>
    </div>
  </nav>
</header>

<style>
  .czh-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, #f97316, #facc15);
    z-index: 999;
    pointer-events: none;
  }
  .czh-strip {
    height: 4px;
    background: linear-gradient(90deg, #f97316, #facc15, #f97316);
  }
  .czh {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--cz-header);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--cz-border);
  }
  .czh-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .czh-logo {
    font-weight: 900;
    font-size: 22px;
    letter-spacing: -0.05em;
    color: var(--cz-text);
    padding: 12px 0;
    white-space: nowrap;
    text-decoration: none;
    font-family: "Inter", system-ui, sans-serif;
  }
  .czh-logo:hover { color: var(--cz-text); }
  .czh-dot { color: var(--cz-accent-text); }
  .czh-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 0;
  }
  .czh-link { color: var(--cz-text-2); padding: 8px 0; text-decoration: none; transition: color 150ms; }
  .czh-link:hover { color: var(--cz-accent-text); }
  .czh-link.active { color: var(--cz-accent-text); }
  .czh-theme {
    background: none;
    border: 1px solid var(--cz-border);
    color: var(--cz-text-2);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    cursor: pointer;
    padding: 0;
    transition: border-color 150ms, color 150ms;
  }
  .czh-theme:hover { border-color: var(--cz-accent-text); color: var(--cz-accent-text); }
  .czh-mobile-actions { display: none; align-items: center; gap: 10px; }
  .czh-theme-m { width: 44px; height: 44px; font-size: 16px; }
  .czh-burger {
    background: none;
    border: 1px solid var(--cz-border);
    color: var(--cz-text);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    cursor: pointer;
    padding: 0;
  }
  .czh-panel {
    background: var(--cz-bg);
    border-top: 1px solid var(--cz-border);
    max-height: calc(100vh - 61px);
    overflow-y: auto;
  }
  .czh-panel-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 24px;
    border-bottom: 1px solid var(--cz-border2);
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: 22px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--cz-text-soft);
    text-decoration: none;
  }
  .czh-panel-link:hover, .czh-panel-link.active { color: var(--cz-accent-text); }
  .czh-arrow { color: var(--cz-accent-text); }
  .czh-panel-cta { padding: 16px 24px 20px; }
  .czh-panel-cta a {
    display: block;
    text-align: center;
    background: #f97316;
    color: #0c0c0c;
    font-weight: 900;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 16px;
    box-shadow: 4px 4px 0 0 #facc15;
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .czh-nav { display: none; }
    .czh-mobile-actions { display: flex; }
  }
  @media (min-width: 861px) {
    .czh-panel { display: none !important; }
  }
</style>

<script>
  const init = () => {
    // ── Tema claro/oscuro (persistido; el atributo lo pone Base.astro sin flash)
    const iconFor = () =>
      document.documentElement.getAttribute("data-cz-theme") === "claro" ? "☾" : "☀";
    const themeBtns = document.querySelectorAll<HTMLButtonElement>(".czh-theme");
    const paintIcons = () => themeBtns.forEach((b) => (b.textContent = iconFor()));
    paintIcons();
    themeBtns.forEach((b) =>
      b.addEventListener("click", () => {
        const claro = document.documentElement.getAttribute("data-cz-theme") === "claro";
        if (claro) document.documentElement.removeAttribute("data-cz-theme");
        else document.documentElement.setAttribute("data-cz-theme", "claro");
        try {
          localStorage.setItem("cz-tema", claro ? "oscuro" : "claro");
        } catch {}
        paintIcons();
      })
    );

    // ── Menú móvil
    const burger = document.querySelector<HTMLButtonElement>(".czh-burger");
    const panel = document.querySelector<HTMLElement>(".czh-panel");
    const closePanel = () => {
      if (!panel || !burger) return;
      panel.hidden = true;
      burger.setAttribute("aria-expanded", "false");
      burger.textContent = "☰";
    };
    if (burger && panel) {
      burger.addEventListener("click", () => {
        const abierto = !panel.hidden;
        panel.hidden = abierto;
        burger.setAttribute("aria-expanded", String(!abierto));
        burger.textContent = abierto ? "☰" : "✕";
      });
      panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", closePanel));
      window.addEventListener("resize", () => {
        if (window.innerWidth > 860) closePanel();
      });
    }

    // ── Barra de progreso de scroll
    const bar = document.querySelector<HTMLElement>(".czh-progress");
    if (bar) {
      let raf = 0;
      const update = () => {
        raf = 0;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : "0%";
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!raf) raf = requestAnimationFrame(update);
        },
        { passive: true }
      );
      update();
    }
  };
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
</script>
